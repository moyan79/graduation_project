# 复制为 env.sh 后修改（不要提交真实路径），每次开终端先 source env.sh
export OPENMMSEC_ROOT=/mnt/nas/public/public_datasets/OpenMMSecV2

# 情况 A: jsons_v4 文件夹模式（train.json + id_test.json + *_ood.json）
export MANIFEST_DIR=$OPENMMSEC_ROOT/jsons_v4

# 情况 B: 单文件模式（只有一个 v4.json，list 或 dict 分 split）
# 用这个时把上面 MANIFEST_DIR 注释掉，脚本会自动改用 --train_json
# export TRAIN_JSON=$OPENMMSEC_ROOT/v4.json

# manifest 里图片路径前缀和远程实际路径不一致时做映射（train.json 里是 /mnt/public/...，远程是 /mnt/nas/...）
# 为空表示不映射；两项必须成对改
export PATH_PREFIX_FROM=/mnt/public/public_datasets/OpenMMSecV2/
export PATH_PREFIX_TO=/mnt/nas/public/public_datasets/OpenMMSecV2/
export EXTRA_ARGS="--path_prefix_from $PATH_PREFIX_FROM --path_prefix_to $PATH_PREFIX_TO"

# 多卡 DDP 默认卡数（单卡脚本忽略它）
export NPROC=4
# torchrun 端口，多任务同机跑时改开避免冲突
export MASTER_PORT=29500
